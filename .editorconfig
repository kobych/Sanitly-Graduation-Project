root = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_coding_style = android_studio
ktlint_standard_chain-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_annotation = disabled

[/build/generated/]
# Exclude build/generated directory from ktlint checks
ktlint = disabled

[/build/buildkonfig/]
# Exclude build/buildkonfig directory from ktlint checks
ktlint = disabled